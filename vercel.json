{
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "portal.lveiendom.no" }], "destination": "/portal/index.html" }
  ],
  "headers": [
    { "source": "/portal/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "X-Frame-Options", "value": "DENY" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
