{
  "routes": [
    { "src": "/api/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "/portal/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow", "X-Frame-Options": "DENY" }, "continue": true },
    { "src": "/", "has": [{ "type": "host", "value": "portal.lveiendom.no" }], "dest": "/portal/index.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow", "X-Frame-Options": "DENY", "Cache-Control": "no-cache" } }
  ]
}
